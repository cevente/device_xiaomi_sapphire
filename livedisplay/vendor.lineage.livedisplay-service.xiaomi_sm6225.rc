on boot
    chown system system /proc/mi_display/tx_cmd_set_prim
    chmod 0666 /proc/mi_display/tx_cmd_set_prim

    chown system system /sys/class/backlight/panel0-backlight/brightness
    chmod 0666 /sys/class/backlight/panel0-backlight/brightness

service vendor.livedisplay-hal /vendor/bin/hw/vendor.lineage.livedisplay-service.xiaomi_sm6225
    class late_start
    user system
    group system
    task_profiles ServiceCapacityLow
