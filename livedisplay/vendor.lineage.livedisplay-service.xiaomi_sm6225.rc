on boot
    chown system system /proc/mi_display/tx_cmd_set_prim

    chmod 0660 /proc/mi_display/tx_cmd_set_prim

service vendor.livedisplay-hal /vendor/bin/hw/vendor.lineage.livedisplay-service.xiaomi_sm6225
    class late_start
    user system
    group system
    task_profiles ServiceCapacityLow
