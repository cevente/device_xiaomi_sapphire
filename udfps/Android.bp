// Android.bp - Pure Rust UDFPS Handler for Xiaomi SM6225

rust_ffi {
    name: "libudfpshandler",
    vendor: true,
    crate_name: "udfps_handler",
    srcs: [
        "src/lib.rs",
        "src/bindings.rs",
        "src/handler.rs",
        "src/touch.rs",
        "src/display.rs",
        "src/monitors.rs",
    ],
    edition: "2021",
    
    // Include directories
    include_dirs: ["include"],
    
    // Rust dependencies
    rustlibs: [
        "liblibc",
        "libnix",
    ],
    
    // Android system libraries
    shared_libs: [
        "liblog",
        "libcutils",
        "libbase",
    ],
    
    // NDK static libraries
    static_libs: [
        "android.hardware.biometrics.fingerprint-V4-ndk",
    ],
    
    // Header dependencies for bindgen
    header_libs: [
        "generated_kernel_headers",
        "//hardware/xiaomi:xiaomifingerprint_headers",
    ],
    
    // Rust compiler flags
    rust_flags: [
        "-C opt-level=3",
        "-C lto=true",
        "-C panic=abort",
        "-C codegen-units=1",
    ],
    
    // Bindgen configuration
    bindgen_flags: [
        "--allowlist-type=ModeType",
        "--allowlist-type=disp_.*",
        "--allowlist-type=fingerprint_device_t",
        "--allowlist-var=TOUCH_.*",
        "--allowlist-var=THP_.*",
        "--allowlist-var=MI_DISP_.*",
        "--allowlist-var=LHBM_.*",
        "--allowlist-var=COMMAND_.*",
        "--allowlist-var=PARAM_.*",
        "--allowlist-var=FOD_STATUS_.*",
        "--allowlist-var=MAX_BUF_SIZE",
        "--blocklist-type=.*__u(8|16|32|64)",
        "--blocklist-type=.*__s(8|16|32|64)",
        "-Iinclude",
        "-Iexternal/libcxx/include",
        "-Isystem/core/libcutils/include",
    ],
    
    product_specific: true,
    vendor_available: true,
}
