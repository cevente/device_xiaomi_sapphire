rust_ffi {
    name: "libudfpshandler",
    vendor: true,
    crate_name: "udfps_handler",
    srcs: ["src/lib.rs"],
    edition: "2021",
    
    rustlibs: [
        "liblibc",
        "libnix",
    ],
    
    shared_libs: [
        "liblog",
        "libcutils",
    ],
    
    product_specific: true,
}
