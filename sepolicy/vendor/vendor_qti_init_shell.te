allow vendor_qti_init_shell proc:dir r_dir_perms;
allow vendor_qti_init_shell proc:file rw_file_perms;
allow vendor_qti_init_shell configfs:dir { add_name create write };
# NECESSARY?
allow vendor_qti_init_shell configfs:dir setattr;
# END
allow vendor_qti_init_shell device:dir r_dir_perms;
allow vendor_qti_init_shell sysfs:file { write };
allow vendor_qti_init_shell vendor_sysfs_msm_perf:file w_file_perms;
allow vendor_qti_init_shell vendor_qti_init_shell:lockdown { integrity };
allow vendor_qti_init_shell vendor_sysfs_qdss_dev:file { setattr write };
allow vendor_qti_init_shell proc_walt:file rw_file_perms;

# To set powerhal init property
set_prop(vendor_qti_init_shell, vendor_power_prop)

allow vendor_qti_init_shell kmsg_device:chr_file { read open write getattr};
allow vendor_qti_init_shell proc_dirty:file { getattr open read write };

allow vendor_qti_init_shell proc_page_cluster:file { open read write getattr };
allow vendor_qti_init_shell proc_watermark_boost_factor:file { open read write getattr };
allow vendor_qti_init_shell proc_sched:file { open read write getattr };

allow vendor_qti_init_shell sysfs_mem_sleep:file { write };
allow vendor_qti_init_shell cgroup:file { getattr };

allow vendor_qti_init_shell sysfs_batteryinfo:file { getattr setattr read write open };

allow vendor_qti_init_shell sysfs:file { getattr setattr read write open };

allow vendor_qti_init_shell cgroup:file read;
allow vendor_qti_init_shell vendor_sysfs_memory:file write;
allow vendor_qti_init_shell vendor_sysfs_scsi_host:file write;
