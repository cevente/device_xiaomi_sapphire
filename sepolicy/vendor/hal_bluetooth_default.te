allow hal_bluetooth_default vendor_mac_vendor_data_file:dir search;
allow hal_bluetooth_default vendor_mac_vendor_data_file:file { open read };

# Assuming you labeled it as 'vendor_ril_btmac_prop' in property.te and property_contexts
set_prop(hal_bluetooth_default, vendor_bluetooth_prop)
get_prop(hal_bluetooth_default, vendor_bluetooth_prop)

allow hal_bluetooth_default default_prop:file read;
allow hal_bluetooth_default default_prop:property_service set;
