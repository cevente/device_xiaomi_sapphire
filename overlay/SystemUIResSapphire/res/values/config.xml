<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- ==================== STRING ARRAYS ==================== -->

    <!-- Doze: Table that translates sensor values from the doze_brightness_sensor_type sensor
               to brightness values (mapped to 4095-scale backlight)
               For 1800 nits display, values scaled appropriately for AOD
               -1 means keeping the current brightness -->
    <integer-array name="config_doze_brightness_sensor_to_brightness">
        <item>-1</item>    <!-- Sensor 0: No change -->
        <item>1</item>     <!-- Sensor 1: Minimum (~0.4 nits) - Very dim AOD -->
        <item>10</item>    <!-- Sensor 2: Very dim (~4.4 nits) -->
        <item>30</item>    <!-- Sensor 3: Dim (~13 nits) -->
        <item>60</item>    <!-- Sensor 4: Low (~26 nits) -->
        <item>100</item>   <!-- Sensor 5: Medium-low (~44 nits) -->
        <item>150</item>   <!-- Sensor 6: Medium (~66 nits) -->
        <item>200</item>   <!-- Sensor 7: Medium-high (~88 nits) -->
        <item>300</item>   <!-- Sensor 8: Bright (~132 nits) -->
        <item>400</item>   <!-- Sensor 9: Very bright (~176 nits) -->
        <item>500</item>   <!-- Sensor 10: High (~220 nits) -->
        <item>700</item>   <!-- Sensor 11: Very high (~308 nits) -->
        <item>1000</item>  <!-- Sensor 12: Max AOD (~440 nits) -->
    </integer-array>

    <!-- Doze: Table that translates sensor values from the doze_brightness_sensor_type sensor
               to an opacity value for a black scrim that is overlayed in AOD.
               Valid range is from 0 (transparent) to 255 (opaque).
               -1 means keeping the current opacity.
               Higher opacity = darker screen, lower opacity = brighter screen -->
    <integer-array name="config_doze_brightness_sensor_to_scrim_opacity">
        <item>-1</item>    <!-- Sensor 0: No change -->
        <item>255</item>   <!-- Sensor 1: Fully opaque (darkest) -->
        <item>220</item>   <!-- Sensor 2: Very opaque -->
        <item>180</item>   <!-- Sensor 3: Mostly opaque -->
        <item>140</item>   <!-- Sensor 4: Partially opaque -->
        <item>100</item>   <!-- Sensor 5: Semi-transparent -->
        <item>70</item>    <!-- Sensor 6: Mostly transparent -->
        <item>50</item>    <!-- Sensor 7: Very transparent -->
        <item>30</item>    <!-- Sensor 8: Barely visible -->
        <item>15</item>    <!-- Sensor 9: Almost transparent -->
        <item>5</item>     <!-- Sensor 10: Very slight tint -->
        <item>2</item>     <!-- Sensor 11: Minimal tint -->
        <item>0</item>     <!-- Sensor 12: Fully transparent (brightest) -->
    </integer-array>

    <!-- OEM fast charger status path -->
    <string-array name="config_oemFastChargerStatusPath">
        <item>/sys/class/qcom-battery/fastcharge_mode</item>
    </string-array>

    <!-- Tiles to auto add to Quick Settings upon first change of a given secure setting.
         The syntax is setting-name:spec. If the tile is a TileService, the spec should be specified
         as custom(package/class). Relative class name is supported. -->
    <string-array name="config_quickSettingsAutoAdd" translatable="false">
        <item>accessibility_display_inversion_enabled:inversion</item>
        <item>wind_down_first_time_setup:custom(com.google.android.apps.wellbeing/.screen.ui.GrayscaleTileService)</item>
        <item>focus_mode_first_time_setup:custom(com.google.android.apps.wellbeing/.focusmode.quicksettings.FocusModeTileService)</item>
    </string-array>

    <!-- ==================== BOOLS ==================== -->

    <!-- Doze: does this device support STATE_DOZE? -->
    <bool name="doze_display_state_supported">true</bool>

    <!-- Doze: check proximity before pulsing -->
    <bool name="doze_proximity_check_before_pulse">true</bool>

    <!-- Doze: Use brightness sensor for AOD brightness control -->
    <bool name="doze_use_brightness_sensor">true</bool>

    <!-- Doze: Enable dynamic AOD brightness -->
    <bool name="doze_dynamic_brightness_enabled">true</bool>

    <!-- ==================== DIMENS ==================== -->

    <!-- Default paddings for content around the corners. -->
    <dimen name="rounded_corner_content_padding">50.0px</dimen>

    <!-- Keyguard affordance horizontal offset -->
    <dimen name="keyguard_affordance_horizontal_offset">20.0dip</dimen>

    <!-- Keyguard affordance vertical offset -->
    <dimen name="keyguard_affordance_vertical_offset">20.0dip</dimen>

    <!-- Keyguard carrier text margin -->
    <dimen name="keyguard_carrier_text_margin">20.0dip</dimen>

    <!-- Keyguard indication margin bottom -->
    <dimen name="keyguard_indication_margin_bottom">16.5dip</dimen>

    <!-- Location on the screen of the center of the physical power button. This is a reasonable
    default that should be overridden by device-specific overlays. -->
    <dimen name="physical_power_button_center_screen_location_y">1040px</dimen>

    <!-- Location on the screen of the center of the fingerprint sensor. For devices with under
     display fingerprint sensors, this directly corresponds to the fingerprint sensor's location.
     For devices with sensors on the back of the device, this corresponds to the location on the
     screen directly in front of the sensor. -->
    <dimen name="physical_fingerprint_sensor_center_screen_location_y">2109px</dimen>

    <!-- Pixel pitch (presumably in microns or similar units) -->
    <item type="dimen" name="pixel_pitch">64.41</item>

    <!-- ==================== INTEGERS ==================== -->

    <!-- The CPU temperature divider, if needed -->
    <integer name="config_cpuTempDivider" translatable="false">1000</integer>

    <!-- If not zero, limits the internal screen recorder's framerate to the set value. -->
    <integer name="config_screenRecorderMaxFramerate">60</integer>

    <!-- Default AOD brightness level (mapped to 4095-scale) -->
    <integer name="config_doze_default_brightness">150</integer>

    <!-- Minimum AOD brightness -->
    <integer name="config_doze_minimum_brightness">1</integer>

    <!-- Maximum AOD brightness (capped to prevent battery drain and burn-in) -->
    <integer name="config_doze_maximum_brightness">700</integer>

    <!-- ==================== STRINGS ==================== -->

    <!-- Type of a sensor that provides a low-power estimate of the desired display
         brightness, suitable to listen to while the device is asleep (e.g. during
         always-on display) -->
    <string name="doze_brightness_sensor_type" translatable="false">xiaomi.sensor.aod</string>

</resources>
